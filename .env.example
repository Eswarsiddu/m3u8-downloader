# Copy to .env and edit. Real environment variables (shell, pm2) override this file.

# Port and address to listen on
PORT=3000
HOST=0.0.0.0

# Where finished files are saved (default: ./downloads next to server.js)
#DOWNLOAD_DIR=/home/ubuntu/downloads

# How many items download at the same time
MAX_CONCURRENT=1

# Login prompt - strongly recommended if the port is reachable from the internet
#APP_USER=admin
#APP_PASSWORD=change-me

# Optional: TMDB name lookup (without these, Wikidata is used)
#TMDB_READ_KEY=
#TMDB_API_KEY=
